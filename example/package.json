{
  "name": "@react-native-harmony-tester",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "i": "cd ../ && npm i && npm run pack && cd ./example && npm i",
    "reStart": "npm run install:pkg && npm run codegen && hdc rport tcp:8081 tcp:8081 && react-native start",
    "start": "hdc rport tcp:8081 tcp:8081 && react-native start",
    "codegen": "react-native codegen-harmony --rnoh-module-path ./harmony/entry/oh_modules/@rnoh/react-native-openharmony",
    "pack:pkg": "cd ../ && npm pack && cd ./example",
    "install:pkg": "npm uninstall @react-native-oh-tpl/react-native-nested-scroll && npm run pack:pkg && npm i @react-native-oh-tpl/react-native-nested-scroll@file:../react-native-oh-tpl-react-native-nested-scroll-0.14.2-rc.5.tgz",
    "dev": "npm run codegen && react-native bundle-harmony --dev --minify=false",
    "prod": "npm run codegen && react-native bundle-harmony --dev=false --minify=true",
    "postinstall": "node ./scripts/create-build-profile",
    "fast-install-project": "cd ../ && npm i --force && npm run pack && rm -r node_modules && cd ./example && npm i --legacy-peer-deps --force --no-audit",
    "fast:pkg": "npm run fast-install-project && npm run dev"
  },
  "dependencies": {
    "@react-native-oh-tpl/react-native-nested-scroll": "file:../react-native-oh-tpl-react-native-nested-scroll-0.14.2-rc.5.tgz",
    "@react-navigation/native": "^6.1.17",
    "react": "18.2.0",
    "react-native": "0.72.5",
    "react-native-harmony": "npm:@react-native-oh/react-native-harmony@^0.72.32",
    "react-native-reanimated": "^3.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.22.10",
    "@babel/preset-env": "^7.22.10",
    "@babel/runtime": "^7.22.10",
    "@react-native-community/cli": "11.3.10",
    "@react-native-community/eslint-config": "^3.2.0",
    "@react-native/metro-config": "^0.76.8",
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.27",
    "@tsconfig/react-native": "^3.0.0",
    "@types/jest": "^29.5.4",
    "@types/react": "^18.2.22",
    "@types/react-test-renderer": "^18.0.0",
    "babel-jest": "^29.6.4",
    "eslint": "^8.48.0",
    "jest": "^29.6.4",
    "metro-react-native-babel-preset": "^0.76.8",
    "prettier": "2.8.8",
    "react-test-renderer": "18.2.0",
    "typescript": "5.2.2"
  },
  "overrides": {
    "@rnoh/react-native-harmony-cli": "npm:@react-native-oh/react-native-harmony-cli@^0.0.27"
  },
  "resolutions": {
    "@react-native-community/cli": "11.3.10"
  },
  "engines": {
    "node": ">=18"
  }
}
